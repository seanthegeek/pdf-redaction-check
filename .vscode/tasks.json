{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build sdist and wheel",
            "detail": "Runs ./build.sh — creates .venv if absent, installs runtime and dev dependencies, then builds into dist/",
            "type": "shell",
            "command": "./build.sh",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true,
                "showReuseMessage": false
            }
        }
    ]
}
